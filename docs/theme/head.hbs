<!-- Additive <head> content for SEO and social sharing. mdBook merges this
     into the default theme; it does not replace it. -->
<meta name="author" content="Barbacane">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Barbacane Documentation">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="https://barbacane.dev/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="https://barbacane.dev/og-image.png">
