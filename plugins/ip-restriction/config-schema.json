{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:barbacane:plugin:ip-restriction:config",
  "title": "IP Restriction Middleware Configuration",
  "type": "object",
  "properties": {
    "allow": {
      "type": "array",
      "items": { "type": "string", "anyOf": [{ "pattern": "^\\s*(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}(\\s*/\\s*(3[0-2]|[12]?[0-9]))?\\s*$" }, { "pattern": "^\\s*[0-9A-Fa-f.]*:[0-9A-Fa-f:.]*(\\s*/\\s*(12[0-8]|1[01][0-9]|[1-9]?[0-9]))?\\s*$" }] },
      "default": [],
      "description": "Allowlist of IPs or CIDR ranges. If non-empty, only these IPs are permitted. An entry that is not an IP address or a CIDR range fails the configuration."
    },
    "deny": {
      "type": "array",
      "items": { "type": "string", "anyOf": [{ "pattern": "^\\s*(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}(\\s*/\\s*(3[0-2]|[12]?[0-9]))?\\s*$" }, { "pattern": "^\\s*[0-9A-Fa-f.]*:[0-9A-Fa-f:.]*(\\s*/\\s*(12[0-8]|1[01][0-9]|[1-9]?[0-9]))?\\s*$" }] },
      "default": [],
      "description": "Denylist of IPs or CIDR ranges (IPv4 and IPv6). These IPs are always blocked (takes precedence over allow). An entry that is not an IP address or a CIDR range fails the configuration."
    },
    "message": {
      "type": "string",
      "default": "Access denied",
      "description": "Custom error message returned to denied requests"
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "default": 403,
      "description": "HTTP status code returned to denied requests"
    }
  },
  "additionalProperties": false
}
