# Barbacane Control Plane - Multi-stage build
# Produces a minimal, rootless container image: the binary on the runtime base
# of docker/runtime.apko.yaml (glibc, libgcc and CA certificates from Wolfi; no
# shell, no package manager).

# The runtime base, built by apko and passed as BASE. Without it, Chainguard's
# glibc-dynamic.
ARG BASE=cgr.dev/chainguard/glibc-dynamic@sha256:2c362104c7f7adc37e6bdc87451450ff3834871a6268d930815cbe561493f947

# Build stage - Rust 1.95+ required (MSRV; wasmtime 48 floor). Debian 12, so
# the binary needs no newer glibc than the runtime base holds.
FROM rust:1.95-slim-bookworm@sha256:d7482085ff5b415f84dba5647ae71606650bdef00db7aeb69f4b3d170c3e4082 AS rust-builder

# Install build dependencies for aws-lc-rs
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    clang \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# `cargo auditable` records the binary's crates in it, where image scanners
# read them.
RUN cargo install --locked cargo-auditable@0.7.7

WORKDIR /build

# Copy manifests first for better layer caching
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

# Limit parallel jobs to avoid OOM in memory-constrained Docker environments
ENV CARGO_BUILD_JOBS=2

RUN cargo auditable build --locked --release --package barbacane-control && \
    cp target/release/barbacane-control /barbacane-control

# The binary alone, for `docker build --target binary --output type=local,dest=<dir>`.
FROM scratch AS binary
COPY --from=rust-builder /barbacane-control /barbacane-control

FROM ${BASE}

# OCI labels for GitHub Container Registry
LABEL org.opencontainers.image.source="https://github.com/barbacane-dev/barbacane"
LABEL org.opencontainers.image.description="Barbacane API Gateway - Control Plane"
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"

COPY --from=rust-builder /barbacane-control /usr/local/bin/barbacane-control

# The compiler caches downloaded plugins under $HOME.
ENV HOME=/home/nonroot

# Run as non-root user (UID 65532)
USER 65532:65532

# Control plane API. The image has no shell, so no HEALTHCHECK: orchestrators
# probe GET /health.
EXPOSE 9090

# The database URL is read from DATABASE_URL.
ENTRYPOINT ["/usr/local/bin/barbacane-control", "serve", "--listen", "0.0.0.0:9090"]
